DATABASE_URL=postgresql+psycopg://wendu:wendu@localhost:5432/wendu
SESSION_SECRET=change-me-to-a-long-random-string
# 生产 HTTPS 反代后设为 true
COOKIE_SECURE=false

# 首次启动创建管理员（若不存在）；部署后请尽快在管理页修改密码
# ADMIN_USER 即种子管理员登录用户名（可为 admin、zhang 等，不必是邮箱）
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# 检索与分块（本地 Embedding 切换后若旧材料检索异常，请删文件重传）
VECTOR_MIN_SCORE=0.28
VECTOR_STRONG_SCORE=0.38
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_K=8

# 本地 Embedding 模型目录（可选；默认 apps/api/models/multilingual-e5-small）
# TEXT_EMBEDDING_LOCAL_PATH=/path/to/multilingual-e5-small

# 原文件目录（本机或服务器磁盘；Docker 下挂载卷）
FILES_DIR=data/files
