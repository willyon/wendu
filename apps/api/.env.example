DATABASE_URL=postgresql+psycopg://wendu:wendu@localhost:5432/wendu
SESSION_SECRET=change-me-to-a-long-random-string

# 首次启动创建管理员（若不存在）；部署后请尽快在管理页修改密码
# ADMIN_USER 即种子管理员登录用户名（可为 admin、zhang 等，不必是邮箱）
ADMIN_USER=admin
ADMIN_PASSWORD=admin

VECTOR_MIN_SCORE=0.28
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_K=8

# 原文件目录（本机或服务器磁盘；Docker 下挂载卷）
FILES_DIR=data/files

PUBLIC_WEB_URL=http://localhost:5173
